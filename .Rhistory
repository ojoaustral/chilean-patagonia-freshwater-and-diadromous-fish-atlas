View(tmp)
tmp <- X %>% group_by(datasetName, datasetName_tmp, occurrenceID) %>% tally() %>% arrange(desc(n))
View(tmp)
tmp <- X %>% group_by(scientificName,datasetName, datasetName_tmp, occurrenceID) %>% tally() %>% arrange(desc(n))
View(tmp)
X %>%
mutate(dataset_prefix = sub(";.*", "", datasetName)) %>%
group_by(rObjectRank_CC) %>%
distinct(dataset_prefix) %>%
kable(caption = "Lista de conjuntos de datos incluidos en el presente Atlas Ictiológico. La primera columna indica el orden de precedencia que es relevante en la exclusión de duplicados.", longtable=F) %>%
kable_styling(bootstrap_options = c("striped", "hover", "condensed"),full_width = F, latex_options = c("HOLD_position"),font_size = 8) %>%
column_spec(column = 1, width = "7em") %>%
column_spec(column = 2, width = "30em")
# 1. Read the polygon
shapefile_AE_Simp <- st_read(
"input_parameters/study_area/Study Area Polygon Pacific and Binational_Simp.shp",  quiet = TRUE)
shapefile_AE_Simp <- st_transform(shapefile_AE_Simp, crs = 4326)
X_all <- X %>% mutate(decimalLatitude  = as.numeric(decimalLatitude) ,
decimalLongitude = as.numeric(decimalLongitude))
# 2. Convert X to sf points
X_sf <- X_all %>%
st_as_sf(coords = c("decimalLongitude","decimalLatitude"), crs = 4326) %>%
st_transform(st_crs(shapefile_AE_Simp))
# 3. Identify points inside
withinAE <- st_within(X_sf, shapefile_AE_Simp, sparse = FALSE)[,1]
X <- X_all[withinAE,]
# nrow(X_all) - nrow(X)
# Map the data
register_stadiamaps(key = Sys.getenv("STADIAMAPS_KEY"))
map <- ggmap(get_stadiamap(bbox = c(left = -76, bottom = -57, right = -64, top = -40), zoom = 5, maptype= "stamen_terrain_background"), darken = c(0.5,"white"))
map +
geom_point(data = X_all[withinAE,], aes(x = decimalLongitude, y = decimalLatitude),
color = "blue", size = 2, alpha=0.3)+
geom_point(data = X_all[!withinAE,], aes(x = decimalLongitude, y = decimalLatitude),
color = "red", size = 2, alpha=0.3)+
geom_sf(data = shapefile_AE_Simp,
inherit.aes = FALSE,
color="blue", fill=NA, alpha = 0.5, linewidth=0.2)
X <- X %>% mutate(
year = ifelse((is.na(year) | year == "") & grepl("^\\d{4}", eventDate),
as.numeric(substr(eventDate, 1, 4)), as.numeric(year)),
eventDate = ifelse((is.na(eventDate) | eventDate == "") & grepl("^\\d{4}", year),
as.character(substr(year, 1, 4)), eventDate))
range(X$year, na.rm=T)
X %>% ggplot(aes(year))+
geom_histogram(binwidth = 10)+
theme_bw()+scale_y_sqrt()
ScN <- read.csv("./input_parameters/AtlasIctiogeográfico_list of taxa_annotated_2026.csv", fileEncoding = "UTF-8", colClasses = "character", stringsAsFactors = FALSE)
tmp <- unique(X$scientificName)
all(tmp %in% ScN$scientificName_Old)
# Identify cases with missing scientificName
# X %>% filter( is.na(scientificName)) %>% select( scientificName_Old)  %>% distinct()
X <- X[!(X$scientificName %in%  c("", "Actinopterygii", "Notothenioidei", "Amphilophus citrinellus × Vieja melanurus")), ]
X %>% select(scientificName) %>% distinct()
## Build a clean lookup table from ScN with filds that will be copied.
taxonomy <- ScN %>%
select(
scientificName_Old, # keep old name
scientificName_new = scientificName, # interim name
canonicalName,
IncludePewProAP,
rank,
kingdom,
phylum,
order,
family,
genus,
species
) %>% distinct() %>% arrange(order, family, genus, scientificName_new)
# Remove taxonomy columns to fully replace/update
X <- X %>% select(-any_of(c(
"canonicalName",
"rank",
"kingdom",
"phylum",
"order",
"family",
"genus",
"species"))) %>%
# Keep original scientificName for matching
mutate(scientificName_Old = scientificName) %>%
# Join taxonomy info
left_join(taxonomy, by = "scientificName_Old") %>%
# Update scientificName if a new one is available
mutate(scientificName = coalesce(scientificName_new, scientificName)) %>%
# Drop helper column
select(-scientificName_new)
# taxcheck <- X %>%
#   select(scientificName_Old, scientificName, canonicalName, rank,
#     kingdom, phylum, order, family, genus, species) %>%
#   distinct() %>%
#   arrange(scientificName)
taxcheck <- X %>%
select(scientificName_Old, scientificName, canonicalName, rank,
kingdom, phylum, order, family, genus, species) %>%
distinct() %>%
arrange(scientificName)
View(taxcheck)
taxonomy2 <- taxonomy %>% mutate(scientificName = scientificName_new) %>% select(-scientificName_new) %>% relocate(scientificName) %>%
arrange(order, family, genus, species)
write.csv(taxonomy2, "./outputs_global_analyses/Output_all_standardized_taxa_list.csv", row.names = F, fileEncoding = "UTF-8")
X.filtered <- X %>%  filter(IncludePewProAP == 1)
X.filtered %>% select(order, family, scientificName) %>% distinct() %>% arrange(order, family, scientificName) %>%
kable(caption = "Lista de nombres científicos luego de la estandarización y el filtrado taxonómico.", col.names = c("Orden", "Familia", "Taxón"),longtable=T) %>%
kable_styling(bootstrap_options = c("striped", "hover", "condensed"),full_width = F, latex_options = c("hold_position"),
font_size = 8) %>%
column_spec(column = 1, width = "10em") %>%
column_spec(column = 2, width = "10em") %>%
column_spec(column = 3, width = "28em")
write.csv(X.filtered %>%
select(order, family, genus, scientificName, canonicalName) %>%
distinct() %>%
arrange(order, family, genus, scientificName),
"./outputs_global_analyses/Output_filtered_standardized_species_list.csv", row.names = FALSE)
t0 <- Sys.time()
# Convert spatial points to spatial data frame
X.spatial <- SpatialPointsDataFrame(coords = X.filtered[, c("decimalLongitude", "decimalLatitude")],
data = X.filtered, proj4string = CRS("EPSG:4326"))
# Convert coordinates to UTM projection (Zone 18S for Chilean Patagonia)
X.projected <- spTransform(X.spatial, CRS("+proj=utm +zone=18 +south +datum=WGS84 +units=m +no_defs"))
# Extract the projected coordinates
coordinates <- coordinates(X.projected)
# Set the distance threshold (in meters)
distance_threshold <- 10 # meters since coords are in UTM
# Run DBSCAN clustering, library(dbscan)
dbscan_result <- dbscan(coordinates, eps = distance_threshold, minPts = 1)
# Assign cluster IDs to the original data frame
X.filtered$spatialClust_CC <- dbscan_result$cluster
t1 <- Sys.time()
cat("Process took:", t1 - t0, "\n")
barplot(sort(table(X.filtered$spatialClust_CC), decreasing = T),
xlab = "cluster", ylab = "number of rows belonging to a cluster")
threshold <- 50
tmp <- sort(table(X.filtered$spatialClust_CC), decreasing = T)
tmp <- tmp[tmp>threshold]
tmp <- X.filtered %>% filter(spatialClust_CC %in% names(tmp)) %>%
select( spatialClust_CC,
decimalLongitude,
decimalLatitude,
canonicalName,
year,
eventDate,
rObjectRank_CC,
datasetName,
locality) %>% distinct()
sort(table(tmp$datasetName), decreasing = T)
tmp <- sort(table(X.filtered$spatialClust_CC), decreasing = T)
tmp
tmp <- sort(table(X.filtered$spatialClust_CC), decreasing = T)
tmp <- tmp[tmp>threshold]
tmp <- X.filtered %>% filter(spatialClust_CC %in% names(tmp)) %>%
select( spatialClust_CC,
decimalLongitude,
decimalLatitude,
canonicalName,
year,
eventDate,
rObjectRank_CC,
datasetName,
locality) %>% distinct()
View(tmp)
threshold <- 50
tmp <- sort(table(X.filtered$spatialClust_CC), decreasing = T)
tmp <- tmp[tmp>threshold]
tmp <- X.filtered %>% filter(spatialClust_CC %in% names(tmp)) %>%
select( spatialClust_CC,
decimalLongitude,
decimalLatitude,
canonicalName,
year,
eventDate,
rObjectRank_CC,
datasetName,
datasetName_tmp,
locality) %>% distinct()
sort(table(tmp$datasetName_tmp), decreasing = T)
cols.dup <- c("spatialClust_CC", "canonicalName", "eventDate", "year")
X.filtered <- X.filtered %>%
arrange(decimalLongitude,
decimalLatitude,
canonicalName,
year,
eventDate,
rObjectRank_CC,
datasetName) %>%
mutate(id_CC = row_number(),
duplicated_CC = duplicated(pick(all_of(cols.dup)), fromLast = TRUE) |
duplicated(pick(all_of(cols.dup)))) %>%
relocate(id_CC,
duplicated_CC,
all_of(cols.dup),
locality,
bibliographicCitation,
datasetName,
recordedBy,
identifiedBy,
catalogNumber,
institutionCode,
institutionID,
occurrenceID,
occurrenceStatus,
collectionCode,
collectionID,
.before = 1)
X.filtered.dedup <- X.filtered %>%
filter(!duplicated(pick(all_of(cols.dup))))
threshold <- 50
tmp <- sort(table(X.filtered.dedup$spatialClust_CC), decreasing = T)
tmp <- tmp[tmp>threshold]
tmp <- X.filtered.dedup %>%
filter(spatialClust_CC %in% names(tmp)) %>%
select( spatialClust_CC,
decimalLongitude,
decimalLatitude,
canonicalName,
year,
eventDate,
rObjectRank_CC,
datasetName,
datasetName_tmp,
locality) %>%
distinct()
sort(table(tmp$datasetName_tmp), decreasing = T)
X.filtered.dedup <- X.filtered.dedup %>% relocate(
id_CC,
datasetName,
decimalLatitude,
decimalLongitude,
canonicalName,
year,
eventDate,
locality,
catalogNumber,
bibliographicCitation,
institutionCode,
occurrenceID)
write.csv(X.filtered.dedup,  paste0("./outputs_global_analyses/dataset_filtered_deduplicated_before_manual_corrections",Sys.Date(),".csv"),
fileEncoding ="UTF-8", row.names = F, dec = ".", na = "NA")
write_rds(X.filtered.dedup, paste0("./outputs_global_analyses/dataset_filtered_deduplicated_before_manual_corrections",
