rm(list = ls())
readRDS("outputs_global_analyses/dataset_filtered_deduplicated_after_manual_corrections_2026-05-29.rds")
X.filtered.dedup.revised <- readRDS("outputs_global_analyses/dataset_filtered_deduplicated_after_manual_corrections_2026-05-29.rds")
View(X.filtered.dedup.revised)
# Load correction table previously processed by script and manual review in ./table_joining/
CM <- read.csv("./input_parameters/Cambios_a_implementar_Argentina_2026-05-30.csv",
encoding = "UTF-8", sep = ",", colClasses = "character",
na.strings = c("", "NA"))
CM <- CM %>% filter(!is.na(prim_key))
CM <- read.csv("./input_parameters/Cambios_a_implementar_Argentina_2026-05-30.csv",
encoding = "UTF-8", sep = ",", colClasses = "character",
na.strings = c("", "NA"))
CM <- read.csv("./input_parameters/Cambios_a_implementar_Argentina_2026-05-30.csv",
encoding = "UTF-8", sep = ",", colClasses = "character",
na.strings = c("", "NA"))
# Retain rows with valid  link to the primary database
CM <- CM %>% filter(!is.na(prim_key))
CM %>% select(Remove_from_master) %>% distinct()
tmp_key <- CM %>% filter(Remove_from_master == "remove") %>% pull(prim_key)
X.filtered.dedup.updating <- X.filtered.dedup.revised %>%
filter(!prim_key %in% tmp_key)
# Update the CM table removing already applied correction
CM <- CM %>% filter(!prim_key %in% tmp_key)
# This identifies all columns in the correction table that begin with ".",
# removes the "." prefix, and checks whether the corresponding base columns
# exist in the master database.
dot_columns <- names(CM)[grepl("^\\.", names(CM))]
base_columns <- sub("^\\.", "", dot_columns)
missing_base_columns <- setdiff(base_columns, names(X.filtered.dedup.updating))
if (length(missing_base_columns) > 0) {
warning(
paste0(
"Las siguientes columnas de corrección no tienen columnas equivalentes en la base de datos principal: ",
paste(paste0(".", missing_base_columns), collapse = ", "),
"\nEstas correcciones serán omitidas a menos que se corrijan los nombres de las columnas."
)
)
} else {
message(
"Todas las columnas de corrección tienen columnas equivalentes en la base de datos principal. Listo para aplicar las actualizaciones."
)
}
# Identificar las columnas de corrección.
dot_columns <- names(CM)[grepl("^\\.", names(CM))]
# Preparar una versión reducida de la tabla de correcciones.
corrections_select <- CM %>%
select(prim_key, all_of(dot_columns))
# Unir la base principal con las correcciones.
# Esta unión agrega temporalmente las columnas con prefijo "." a la base principal,
# usando `prim_key` como clave de correspondencia.
X.filtered.dedup.updating <- X.filtered.dedup.updating %>%
left_join(corrections_select, by = "prim_key")
# Crear una tabla vacía para registrar el resumen de actualizaciones.
update_summary <- tibble(
correction_column = character(),
updated_column = character(),
proposed_updates = integer(),
actual_changes = integer()
)
# Aplicar las correcciones y registrar el número de actualizaciones.
for (dot_col in dot_columns) {
base_col <- sub("^\\.", "", dot_col)
if (base_col %in% names(X.filtered.dedup.updating)) {
# Contar valores no faltantes en la columna de corrección.
# Estos corresponden a correcciones propuestas.
proposed_updates <- X.filtered.dedup.updating %>%
summarise(n = sum(!is.na(.data[[dot_col]]))) %>%
pull(n)
# Contar cambios efectivos.
#
# Un cambio efectivo ocurre cuando:
# - existe una corrección en la columna con prefijo ".";
# - y el valor corregido es distinto del valor actualmente presente
#   en la columna base.
actual_changes <- X.filtered.dedup.updating %>%
summarise(
n = sum(
!is.na(.data[[dot_col]]) &
(
is.na(.data[[base_col]]) |
as.character(.data[[dot_col]]) != as.character(.data[[base_col]])
)
)
) %>%
pull(n)
# Registrar el resumen para esta columna.
update_summary <- update_summary %>%
add_row(
correction_column = dot_col,
updated_column = base_col,
proposed_updates = proposed_updates,
actual_changes = actual_changes
)
# Aplicar la actualización:
# si existe un valor no faltante en la columna de corrección,
# este reemplaza el valor de la columna base.
X.filtered.dedup.updating <- X.filtered.dedup.updating %>%
mutate(
!!base_col := ifelse(
!is.na(.data[[dot_col]]),
.data[[dot_col]],
.data[[base_col]]
)
)
} else {
warning(
paste0(
"Column '", base_col,
"' not found in X.filtered.dedup.updating. Skipping update for '",
dot_col, "'."
)
)
}
}
# Reportar resumen de actualizaciones.
message(
paste0(
"Correcciones propuestas: ", sum(update_summary$proposed_updates), "\n",
"Cambios efectivos aplicados: ", sum(update_summary$actual_changes), "\n",
"Registros afectados: ",
X.filtered.dedup.updating %>%
filter(if_any(all_of(dot_columns), ~ !is.na(.x))) %>%
nrow()
)
)
update_summary %>% kable(
row.names = FALSE,
caption = "Resumen de frecuancias de correcciones o cambios  específicos realizados luego de la inspección manual de los datos.",
booktabs = TRUE,
# col.names = c("Column", "Non-NA Count", "Total Rows", "% Non-NA", "NA Count")
) %>%
kable_styling(
latex_options = c("striped", "hold_position", "scale_down", "condensed"),
font_size = 10,
full_width = FALSE
) %>%
row_spec(0, bold = TRUE)
X.filtered.dedup.revised <- X.filtered.dedup.updating %>%
select(-all_of(dot_columns))
write.csv(X.filtered.dedup.revised,
paste0("./outputs_global_analyses/dataset_filtered_deduplicated_after_manual_corrections_Ar_",Sys.Date(),".csv"),
fileEncoding ="UTF-8", row.names = F, dec = ".", na = "NA")
write_rds(X.filtered.dedup.revised,
paste0("./outputs_global_analyses/dataset_filtered_deduplicated_after_manual_corrections_Ar_",
Sys.Date(), ".rds"))
X.filtered.dedup.revised2 <- X.filtered.dedup.updating %>%
select(-all_of(dot_columns))
