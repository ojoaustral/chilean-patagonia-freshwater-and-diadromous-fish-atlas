)
# Set bounding box for Chile and Argentina
# chile_argentina_bbox <- c(-77, -57, -65, -40)
bbox <- make_bbox(study.area$long, study.area$lat, f = 0.1)
# Get reference map using ggmap
register_stadiamaps(key = "f4aaa648-6137-4e34-a850-46c9821d7a6a")
# map <- ggmap(
#   get_stadiamap(bbox = bbox, zoom = 5, maptype = "stamen_terrain_background"), darken = c(0.5,"white")
#   )
map <- ggmap(get_stadiamap(bbox = c(left = -76, bottom = -57, right = -64, top = -40), zoom = 5, maptype= "stamen_terrain_background"))
tmp <- X.filtered.dedup %>% group_by(family) %>%
summarise(nOccFam = n()) %>% arrange(desc(nOccFam))
X.filtered.dedup$family <- factor(X.filtered.dedup$family,levels=tmp$family)
data <- X.filtered.dedup %>% filter(!is.na(family)) %>%
droplevels()
map + geom_point(data = data, aes(x = decimalLongitude, y = decimalLatitude), size = 2, alpha=0.5, color="red")+
facet_wrap(~family, ncol = 5)+
geom_polygon(data = study.area_coords,
aes(x = lon, y = lat), color="black", fill=NA, alpha = 0.5)+
theme(strip.text = element_text(size = 14))
ggsave("map_records per familia.png", plot = last_plot(), width = 8, height = 11, dpi = 300)
unlink("Atlas_Ictiogeografico_cache", recursive = TRUE)
knit_with_parameters("~/GitHub/Atlas_Ictiogeografico/Atlas_Ictiogeografico.Rmd")
